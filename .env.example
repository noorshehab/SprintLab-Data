# MLflow tracking backend. Omit to fall back to a local ./mlruns file store.
# For a remote Postgres-backed server:
# MLFLOW_TRACKING_URI=postgresql://mlflow:mlflow@host:5432/mlflow
MLFLOW_TRACKING_URI=file:./mlruns
ARTIFACT_PATH=./mlruns

# Local notebook execution (unused on Modal -- modal/app.py sets these itself)
DATA_DIR=./data
OUTCOMES_DIR=./outcomes
CACHE_DIR=./cache

# Modal auth is via `modal token set` / ~/.modal.toml, not env vars here.
